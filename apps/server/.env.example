# Copy to `.env` and adjust. Never commit a real `.env`.
# For production (Docker / single binary) see DEPLOYMENT.md.
PORT=4000
# Comma-separated list of allowed browser origins (web app only). Unset for
# same-origin deployments (Docker, single binary, dev proxy).
CORS_ORIGINS=http://localhost:3000
# OPTIONAL root admin account. When both are set, root is the env-configured
# virtual account. When unset, the web shows a first-run screen that creates
# the root account instead (Auth.setupRoot refuses once root exists). Root
# always holds every capability and is immutable from the UI either way.
#ROOT_USERNAME=admin
#ROOT_PASSWORD=change-me
# Freqtrade REST endpoint. The browser never sees this value.
FREQTRADE_URL=http://127.0.0.1:8080
FREQTRADE_USERNAME=freqtrader
FREQTRADE_PASSWORD=
FREQTRADE_TIMEOUT_MS=10000
# SQLite snapshot store (profit/balance history for the terminal charts).
# Resolves to the gitignored <repo-root>/.data/ folder (server CWD is apps/server).
SQLITE_PATH=../../.data/nfi-desk.db
# How often the background poller snapshots freqtrade into sqlite.
SNAPSHOT_INTERVAL_MS=60000
# Web shell directory for Node boots (default: ../web/dist). The compiled
# single binary ignores this — its shell is embedded.
#STATIC_DIR=
